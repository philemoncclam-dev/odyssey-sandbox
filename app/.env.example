# MSAL sign-in (src/auth/config.ts). Not secrets — a SPA app registration's
# client ID and tenant ID are public identifiers — but unset until an Entra
# admin creates the app registration, so sign-in fails loudly instead of
# authenticating against nothing.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
VITE_MSAL_REDIRECT_URI=
